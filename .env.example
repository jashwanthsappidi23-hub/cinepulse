# ============================================================================
# CinePulse Cinema Screening & Ticket Booking System
# Environment Variable Configuration Template
# ============================================================================

# Database URL Configuration:
# To connect to a local or production MySQL database:
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/CinemaBookingDB

# SQLite Local Database (Default auto-fallback if MySQL is offline):
SQLITE_URL=sqlite:///./CinemaBookingDB.sqlite

# Active Database Override (Optional, leave blank to enable auto-detection):
DATABASE_URL=

# Authentication Secret Key (Generate a random 32-character key for production):
SECRET_KEY=cinepulse-super-secret-academic-dbms-token-key-2026

# Seat Lock Time-To-Live (Seconds during seat selection):
SEAT_LOCK_TTL_SECONDS=300
